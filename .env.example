# Lightweight `npm run dev:ui` preview only. The default `npm run dev` uses
# an isolated generated local Worker configuration at localhost:8788 instead.
# Cloudflare configuration lives in wrangler.jsonc
# (non-secret vars) and `wrangler secret put` (secrets). Never commit secrets.
#
# With D1 there is no DATABASE_URL: the database is a Worker binding.

# "preview" runs on fictional in-browser data and never touches D1.
APP_MODE="preview"

# Must exactly match the browser origin, or authenticated writes are rejected.
APP_URL="http://localhost:3000"

# Hosted AI: set AI_PROVIDER=groq as a non-secret Worker variable only when
# the replacement GROQ_API_KEY has been stored using the Worker secret UI.
# No NEXT_PUBLIC key. Preview never calls AI. No other provider fallback.
# AI_PROVIDER="groq"
# GROQ_API_KEY=""

# --- First administrator -------------------------------------------------
# Used once by `npm run db:bootstrap`, then removed again.
BOOTSTRAP_EMAIL=""
BOOTSTRAP_PASSWORD=""
BOOTSTRAP_CONFIRM=""

# --- Website intake (optional) -------------------------------------------
# One pair per company slug. Set as Worker secrets in production.
# INTAKE_PETRONIK_SECRET=""
# INTAKE_PETRONIK_OWNER_ID=""

# Private mailbox setup belongs to Worker secrets, not this UI preview file.
# MAILBOX_ENCRYPTION_KEY: 32 random bytes encoded as base64; keep a separate backup.
# MAILBOX_ALLOWED_HOSTS: administrator-approved hosts, default mail.petronik.ae.
# The full local launcher generates its own ignored encryption key.
