{
  "name": "enercore-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-meeting-assets.mjs",
    "dev": "next dev --webpack",
    "prebuild": "node scripts/copy-meeting-assets.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply enercore-crm --local",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:migrate:remote": "wrangler d1 migrations apply enercore-crm --remote",
    "precf:build": "node scripts/copy-meeting-assets.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:deploy:live": "opennextjs-cloudflare deploy -- --env live",
    "cf:preview:live": "opennextjs-cloudflare preview -- --env live",
    "db:backup": "bash scripts/backup-d1.sh",
    "test:collab": "npm run cf:build && playwright test -c playwright.collab.config.ts",
    "test:collab:nofiles": "playwright test -c playwright.collab-nofiles.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@livekit/components-react": "^2.9.24",
    "@livekit/track-processors": "0.8.1",
    "@noble/hashes": "^2.4.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "drizzle-orm": "^0.45.3",
    "livekit-client": "^2.22.3",
    "lucide-react": "^0.468.0",
    "next": "16.3.5",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.136.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
