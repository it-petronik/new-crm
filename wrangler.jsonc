{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "enercore-crm",
	// worker.ts wraps the OpenNext handler (.open-next/worker.js) to add the
	// Collaboration Hub's realtime socket and Durable Object class.
	"main": "worker.ts",
	"compatibility_date": "2026-09-01",
	// nodejs_compat is required by the Next.js runtime and by node:crypto usage.
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": { "enabled": true },

	// ------------------------------------------------------------------
	// TOP LEVEL = the preview Worker on workers.dev.
	// Deployed with:  npm run cf:deploy
	// This must stay APP_MODE=preview and serve fictional in-browser data.
	// ------------------------------------------------------------------
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "enercore-crm",
			"database_id": "71f8d380-5c3c-478b-822c-7fcd47b102d2",
			"migrations_dir": "drizzle"
		}
	],
	"vars": {
		"APP_MODE": "preview",
		"NODE_ENV": "production",
		"APP_URL": "https://enercore-crm.red-bread-8f67.workers.dev"
	},

	// ------------------------------------------------------------------
	// ENVIRONMENT "live" = the real CRM on crm.enercore.ae.
	// Deployed with:  npm run cf:deploy:live
	// Wrangler publishes this as a SEPARATE Worker script
	// (enercore-crm-live), so deploying the preview Worker can never
	// change the live one, and vice versa.
	//
	// wrangler does NOT inherit `vars`, `d1_databases` or `routes` into an
	// environment, so each is declared explicitly below. The database_id is
	// deliberately the same verified database that already holds the
	// administrator - this is intentional shared state, not a copy.
	// ------------------------------------------------------------------
	"env": {
		"live": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "enercore-crm",
					"database_id": "71f8d380-5c3c-478b-822c-7fcd47b102d2",
					"migrations_dir": "drizzle"
				}
			],
			"vars": {
				"APP_MODE": "production",
				"NODE_ENV": "production",
				"APP_URL": "https://crm.enercore.ae"
			},
			"routes": [
				{ "pattern": "crm.enercore.ae", "custom_domain": true }
			],
			"observability": { "enabled": true },
			// Collaboration Hub realtime: one SQLite-backed Durable Object per
			// person, relaying live events to their open sockets. Live only —
			// preview serves fictional data and has no collaboration backend.
			// The namespace is created by the first `cf:deploy:live` that
			// includes this block; nothing exists remotely until then.
			"durable_objects": {
				"bindings": [
					{ "name": "COLLAB_HUB", "class_name": "CollabHub" }
				]
			},
			"migrations": [
				{ "tag": "v1-collab-hub", "new_sqlite_classes": ["CollabHub"] }
			],
			// Collaboration V2 files (attachments, voice notes, room images).
			// Private bucket, reached only through the Worker's authorised
			// file route — never public, never bound to preview. Create it with
			// `wrangler r2 bucket create enercore-collab-files` before the
			// first deploy that includes this block.
			"r2_buckets": [
				{ "binding": "COLLAB_FILES", "bucket_name": "enercore-collab-files" }
			],
			// 02:23 UTC: purge of unsent uploads (after 1 day) and of files
			// whose message was deleted more than 30 days ago.
			// 04:00 UTC (08:00 GST): notification reminders — follow-ups due
			// or overdue, expiring quotations, overdue payments, late
			// shipments and tickets — plus notification retention.
			"triggers": { "crons": ["23 2 * * *", "0 4 * * *"] }
		}
	}
}
